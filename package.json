{
  "name": "auth",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote",
    "test": "node --experimental-strip-types --test test/**/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,jsonc,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,jsonc,md,ts}\""
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "wrangler": "4.139.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
  }
}
