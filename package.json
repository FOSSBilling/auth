{
  "name": "auth",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify",
    "build": "npm run build:css",
    "predev": "npm run build",
    "dev": "cf dev",
    "cf-deploy": "npm run build && cf deploy",
    "cf-preview": "cf previews deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "cf d1 migrations apply 43ce5ec3-5ddd-429b-b9e8-550a80d0edf9 --local",
    "db:migrate:remote": "cf d1 migrations apply 43ce5ec3-5ddd-429b-b9e8-550a80d0edf9",
    "test": "node --test test/**/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,jsonc,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,jsonc,md,ts}\""
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.1",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.9",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "basecoat-css": "1.1.0",
    "cf": "1.0.0-rc.2",
    "drizzle-kit": "0.31.11",
    "lucide-static": "1.77.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "@parcel/watcher": true
  }
}
